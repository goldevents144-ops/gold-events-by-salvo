// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Gold Events — Application data
// ============================================================

/// Contact form submissions from customers (form A in #contatti)
model ContactSubmission {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fullName    String
  eventType   String
  eventDate   String
  location    String
  guests      Int
  services    String // JSON-encoded array of service IDs
  notes       String?

  status      String   @default("new") // new | read | contacted | archived
  adminNotes  String?

  @@index([createdAt])
  @@index([status])
}

/// Partner form submissions (form B in #partner)
model PartnerSubmission {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  businessName  String
  activityType  String
  location      String
  referentName  String
  referentPhone String
  referentEmail String
  capacity      String?
  hasPower      String   // "si" | "no"
  b2bRates      String?

  status        String   @default("new") // new | contacted | approved | archived
  adminNotes    String?

  @@index([createdAt])
  @@index([status])
}

/// Chatbot conversation sessions (for context + audit)
model ChatSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  String   // JSON-encoded array of {role, content}
  lang      String   @default("it")
  userAgent  String?
  ipHash    String?  // SHA-256 hash for rate-limit, never raw IP

  @@index([createdAt])
}

/// Simple admin session token (single-owner model)
model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String?

  @@index([expiresAt])
}

/// Admin credentials (single owner — bcrypt password hash + TOTP secret for 2FA)
model AdminCredential {
  id              String   @id @default("singleton")
  passwordHash    String   // bcrypt hash
  totpSecret      String?  // base32 TOTP secret (set after 2FA enrollment)
  totpEnrolledAt  DateTime?
  recoveryCodes   String?  // JSON-encoded array of bcrypt-hashed recovery codes
  updatedAt       DateTime @updatedAt
}

/// Audit log for admin actions (security compliance)
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String   // login | logout | view_submission | delete_submission | edit_content | ...
  target    String?
  ipHash    String?
  userAgent String?
  meta      String?  // JSON-encoded extras

  @@index([createdAt])
  @@index([action])
}

/// Editable site content snippets (managed via admin AI assistant)
model SiteContent {
  id       String @id
  value    String
  updatedAt DateTime @updatedAt

  @@index([id])
}
