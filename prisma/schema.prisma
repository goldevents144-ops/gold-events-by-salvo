generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fullName     String
  email        String?
  phone        String?
  eventType    String
  eventDate    String
  location     String
  guests       Int
  services     String
  notes        String?
  status       String   @default("new")
  adminNotes   String?
  repliedAt    DateTime?
  repliedVia   String?  // "whatsapp" | "email" | "phone"
  repliedText  String?
  budget       String?
  closedAt     DateTime?
  starred      Boolean  @default(false)
  @@index([createdAt])
  @@index([status])
  @@index([starred])
}

model PartnerSubmission {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  businessName  String
  activityType  String
  location      String
  referentName  String
  referentPhone String
  referentEmail String
  capacity      String?
  hasPower      String
  b2bRates      String?
  status        String   @default("new")
  adminNotes    String?
  @@index([createdAt])
  @@index([status])
}

model ChatSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  String
  lang      String   @default("it")
  userAgent  String?
  ipHash    String?
  @@index([createdAt])
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String?
  @@index([expiresAt])
}

model AdminCredential {
  id              String   @id @default("singleton")
  passwordHash    String
  totpSecret      String?
  totpEnrolledAt  DateTime?
  recoveryCodes   String?
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String
  target    String?
  ipHash    String?
  userAgent String?
  meta      String?
  @@index([createdAt])
  @@index([action])
}

model SiteContent {
  id       String @id
  value    String
  updatedAt DateTime @updatedAt
  @@index([id])
}

model ChatConversation {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  visitorName  String?
  visitorEmail String?
  visitorPhone String?
  visitorIp    String?
  userAgent    String?
  status       String   @default("active") // active | waiting | closed
  lastMessageAt DateTime?
  unreadByAdmin  Int @default(0)
  unreadByVisitor Int @default(0)
  messages     ChatMessage[]
  @@index([createdAt])
  @@index([status])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String   // "visitor" | "admin" | "system"
  text           String
  readAt         DateTime?
  @@index([conversationId])
  @@index([createdAt])
  @@index([role])
}
